datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  users     User[]
  projects  Project[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  password       String
  name           String
  role           String       @default("USER") // ADMIN, USER
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Project {
  id             String       @id @default(uuid())
  name           String
  description    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  testCases      TestCase[]
  executions     Execution[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model TestCase {
  id          String      @id @default(uuid())
  title       String
  description String?
  steps       Json        // Array of steps: { action, target, value }
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id])
  feature     String?     // "Login", "Cart", etc.
  executions  Execution[] // Track executions for this specific test case
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Execution {
  id            String    @id @default(uuid())
  status        String    // PENDING, RUNNING, PASSED, FAILED
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id])
  testCaseId    String?   // Optional: for single test case executions
  testCase      TestCase? @relation(fields: [testCaseId], references: [id])
  results       Json?     // Detailed results
  videoUrl      String?
  logs          String?
  errorAnalysis String?
  testCaseIds   String[]  @default([]) // Legacy: for batch executions
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model StepDefinition {
  id        String   @id @default(uuid())
  text      String   @unique
  normalized String
  type      String   // GIVEN, WHEN, THEN
  embedding Float[]  // Vector for similarity
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DomCache {
  id              String   @id @default(uuid())
  domain          String   @unique
  url             String
  data            Json     // Stores DomCacheEntry
  lastUpdatedAt   DateTime @default(now())
  createdAt       DateTime @default(now())
}

model VerifiedSelector {
  id          String   @id @default(uuid())
  elementName String   @unique
  selector    String
  type        String   // css, xpath
  context     String
  url         String?
  verifiedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
}
